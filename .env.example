# Base Neon (Postgres) : chaîne de connexion « pooled » depuis la console Neon
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/bonbox?sslmode=require"

# Better Auth : secret aléatoire (openssl rand -base64 32) et URL publique de l'app
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
