# Base de données
#   En local : la base Docker lancée par `docker compose up -d` (valeur ci-dessous)
#   En production : la chaîne « pooled » de Neon, avec ?sslmode=require
DATABASE_URL="postgresql://bonbox:bonbox@localhost:5432/bonbox"

# Better Auth : secret aléatoire (au moins 32 caractères) et URL publique de l'app
BETTER_AUTH_SECRET="dev-secret-a-remplacer-en-production-0123456789"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
